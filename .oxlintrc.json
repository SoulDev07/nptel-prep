{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "no-unused-vars": [
      "error",
      {
        "varsIgnorePattern": "^[A-Z_]"
      }
    ]
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": [
    "dist"
  ]
}